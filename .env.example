# ==============================================================================
# ASCEND CA Community — Production Environment Template
# Copy this file to .env and configure secret keys before running services
# ==============================================================================

# Node Environment
NODE_ENV=production

# Database (PostgreSQL 16)
POSTGRES_USER=ascend_admin
POSTGRES_PASSWORD=generate_strong_db_password_here
POSTGRES_DB=ascend_ca
DATABASE_URL=postgresql://ascend_admin:generate_strong_db_password_here@localhost:5432/ascend_ca?schema=public

# Redis 7 Cache & Task Queue
REDIS_PASSWORD=generate_strong_redis_password_here
REDIS_URL=redis://:generate_strong_redis_password_here@localhost:6379

# Cryptographic Keys (Mandatory: replace with secure random values)
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_ADMIN_SECRET=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
# 32-byte key for AES-256-GCM encryption of sensitive PII (ICAI MRN, phone numbers)
DATA_ENCRYPTION_KEY=01234567890123456789012345678901

# Admin Isolation & Routing
ADMIN_API_ENABLED=true
ADMIN_ALLOWED_ORIGIN=https://admin.ascend-ca.in
WEB_ALLOWED_ORIGIN=https://ascend-ca.in

# Public Next.js Endpoints
NEXT_PUBLIC_APP_URL=https://ascend-ca.in
NEXT_PUBLIC_API_URL=https://api.ascend-ca.in/api/v1
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.ascend-ca.in
NEXT_PUBLIC_ADMIN_API_URL=https://api.ascend-ca.in/admin-api/v1

# Interim Admin Access Gate (HTTP Basic, required until real admin login ships)
# The admin app answers 503 while these are unset. Generate with: openssl rand -base64 24
ADMIN_GATE_USER=
ADMIN_GATE_PASSWORD=

# Razorpay Payment Gateway (Production Mode)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Statutory GST & Billing Details (SAC 998399)
GST_RATE_PERCENTAGE=18
GSTIN=07AAAAA0000A1Z5
COMPANY_NAME="ASCEND Chartered Accountants Community"
COMPANY_ADDRESS="Bharat Mandapam, Pragati Maidan, New Delhi - 110001"

# Email Delivery (Transactional Notifications & PDF Invoices)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM="ASCEND Community <hello@ascend-ca.in>"
