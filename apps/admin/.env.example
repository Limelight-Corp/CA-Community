NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000/admin-api/v1"
NEXT_PUBLIC_ADMIN_APP_URL="http://localhost:3001"

# Fallback admin sign-in (accounts from `npm run admin:seed` are preferred). HTTP Basic also accepted for scripts.
# Optional when an admin account has been seeded. Use a long random password.
ADMIN_GATE_USER=""
ADMIN_GATE_PASSWORD=""
# Optional: overrides the session signing secret created by `npm run admin:seed`.
# ADMIN_SESSION_SECRET=""
# Local development only: set to "true" to bypass the gate. Ignored when NODE_ENV=production.
# ADMIN_GATE_DISABLED="true"

# Email to attendees when a booking is cancelled, refunded or marked paid. Use the same SMTP
# settings as the website; without SMTP_HOST, emails are saved to data/outbox/ instead.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="ASCEND <hello@your-domain.in>"
# Public website URL used for links in emails.
# WEBSITE_URL="http://localhost:3000"
