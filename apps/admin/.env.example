NEXT_PUBLIC_ADMIN_API_URL="http://localhost:4000/admin-api/v1"
NEXT_PUBLIC_ADMIN_APP_URL="http://localhost:3001"

# Admin sign-in credentials for the /login page (HTTP Basic also accepted for scripts).
# Nobody can sign in while these are unset. Use a long random password.
ADMIN_GATE_USER=""
ADMIN_GATE_PASSWORD=""
# Recommended in production: long random value used to sign admin session cookies.
# ADMIN_SESSION_SECRET=""
# Local development only: set to "true" to bypass the gate. Ignored when NODE_ENV=production.
# ADMIN_GATE_DISABLED="true"
