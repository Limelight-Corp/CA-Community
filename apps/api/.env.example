# Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ascend_ca?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secret Keys
JWT_ACCESS_SECRET="dev_access_secret_super_secure_key_change_in_production"
JWT_REFRESH_SECRET="dev_refresh_secret_super_secure_key_change_in_production"
JWT_ADMIN_SECRET="dev_admin_secret_super_secure_key_change_in_production"

# Encryption (AES-256-GCM for sensitive fields)
DATA_ENCRYPTION_KEY="01234567890123456789012345678901" # 32-byte hex or string

# Admin API Gateway Isolation Flag
ADMIN_API_ENABLED=true
ADMIN_ALLOWED_ORIGIN="http://localhost:3001"
WEB_ALLOWED_ORIGIN="http://localhost:3000"

# Razorpay (Test Mode Keys)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret_key"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# GST Configuration
GST_RATE_PERCENTAGE=18
GSTIN="07AAAAA0000A1Z5"
COMPANY_NAME="ASCEND Chartered Accountants Community"
COMPANY_ADDRESS="Bharat Mandapam, Pragati Maidan, New Delhi - 110001"

# Email (SMTP / Resend)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="placeholder"
SMTP_FROM="ASCEND Community <hello@ascend-ca.in>"
