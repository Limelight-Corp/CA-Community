NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"

# Support chat assistant (Claude). Without a key the chat runs in basic mode (quick actions, search, links, follow-up form).
# ANTHROPIC_API_KEY=""

# Analytics & search (optional). GA4 measurement ID, e.g. G-XXXXXXXXXX.
# NEXT_PUBLIC_GA_ID=""
# Google Search Console "HTML tag" verification code (the content="…" value only).
# GOOGLE_SITE_VERIFICATION=""

# Email (booking confirmations, receipts, admin alerts). Without SMTP_HOST, emails are saved
# to data/outbox/ for testing instead of being sent. Port 465 uses TLS; 587 uses STARTTLS.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="ASCEND <hello@your-domain.in>"
# Who receives admin alerts (comma-separated). Defaults to the contact email in Site Settings.
# ADMIN_NOTIFY_EMAIL=""
# Admin console URL used in "Open in admin" links.
# ADMIN_APP_URL="http://localhost:3001"

# Razorpay webhook (Dashboard → Settings → Webhooks → URL <site>/api/payments/razorpay/webhook,
# events payment.captured, payment.failed, order.paid). Confirms bookings even if the browser closes.
# RAZORPAY_WEBHOOK_SECRET=""
# Razorpay API keys (server side; test keys start with rzp_test_).
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""

# Event reminders: emailed the day before (or on the day) to confirmed attendees. The web server
# checks hourly by itself; on serverless hosts set REMINDER_SCHEDULER=off and call
# GET /api/cron/reminders with "Authorization: Bearer <CRON_SECRET>" (e.g. Vercel Cron, hourly).
# CRON_SECRET=""
# REMINDER_SCHEDULER="on"

# Daily backup of data/ (see scripts/backup-data.mjs; also `npm run backup`).
# BACKUP_DIR="backups"        # relative to the repo, or an absolute path (e.g. another disk)
# BACKUP_KEEP="14"            # how many daily backups to keep
# BACKUP_SCHEDULER="on"       # "off" to disable the in-server daily run

# Analytics / ads (loaded only after cookie consent). GA_MEASUREMENT_ID is read at runtime.
# GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# META_PIXEL_ID=""

# Cloudflare Turnstile CAPTCHA on public forms (both keys needed to switch it on).
# TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
