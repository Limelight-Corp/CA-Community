{
  "name": "ascend-ca-community",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=@ascend/shared && npm run build --workspace=@ascend/ui",
    "build": "npm run build:packages && npm run build --workspace=@ascend/api && npm run build --workspace=@ascend/web && npm run build --workspace=@ascend/admin",
    "dev:web": "npm run dev --workspace=@ascend/web",
    "dev:admin": "npm run dev --workspace=@ascend/admin",
    "dev:api": "npm run dev --workspace=@ascend/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "npm run db:generate --workspace=@ascend/api",
    "db:migrate": "npm run db:migrate --workspace=@ascend/api",
    "db:seed": "npm run db:seed --workspace=@ascend/api",
    "admin:seed": "npm run admin:seed --workspace=@ascend/admin --",
    "member:seed": "node scripts/seed-member.mjs",
    "backup": "node scripts/backup-data.mjs",
    "seed:test": "node scripts/seed-test-data.mjs",
    "docs:openapi": "npm run docs:openapi --workspace=@ascend/api"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
