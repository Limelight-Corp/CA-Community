// ASCEND community — PostgreSQL schema for the web + admin apps.
//
// Replaces the JSON files in data/ (community-store, private-store, member-accounts,
// admin-users). Design notes, the index rationale and the security model are in
// docs/DATABASE_DESIGN.md. Constraints Prisma cannot express (CHECKs, partial unique indexes,
// trigram indexes, roles and grants) live in packages/db/sql/*.sql and are applied after the
// Prisma migration.
//
// Conventions
// - Tables and columns are snake_case in the database (@@map / @map).
// - Ids are text UUIDs (gen_random_uuid(), built into PostgreSQL 13+), so existing JSON ids can be
//   kept during migration.
// - Every timestamp is timestamptz(3). Money is numeric(10,2) in rupees.
// - Secrets are never stored in plaintext: passwords are scrypt hashes, every token is a
//   SHA-256 hash, and signing secrets stay in environment variables.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Own output folder so this client never overwrites apps/api's generated @prisma/client.
  output          = "../generated/client"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Migrations run as the schema owner; the apps connect with least-privilege roles.
  directUrl  = env("DATABASE_MIGRATION_URL")
  extensions = [citext, pg_trgm]
}

// ===========================================================================================
// Enums
// ===========================================================================================

enum EventMode {
  ONLINE
  OFFLINE
}

enum RegistrationStatus {
  CONFIRMED
  PENDING_PAYMENT
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MembershipPlan {
  CORE
  ASSOCIATE
  STUDENT
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  RAZORPAY
  OFFLINE
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum MentorStatus {
  PENDING
  APPROVED
  PAUSED
  REJECTED
}

enum MentorMode {
  ONLINE
  IN_PERSON
}

enum MentorshipStage {
  CA_STUDENT
  NEWLY_QUALIFIED
  PRACTISING
  INDUSTRY
  OTHER
}

enum MentorshipRequestStatus {
  OPEN
  MATCHED
  CLOSED
  DECLINED
}

enum TeamGroup {
  LEADERSHIP
  CORE_TEAM
  ADVISORY_BOARD
  WING_CONVENERS
}

enum TaxonomyKind {
  EVENT_CATEGORY
  NEWS_CATEGORY
  RESOURCE_CATEGORY
  GALLERY_CATEGORY
  JOB_TYPE
}

enum WorkMode {
  ON_SITE
  HYBRID
  REMOTE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum OutboxChannel {
  EMAIL
  WHATSAPP
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

// ===========================================================================================
// Site configuration
// ===========================================================================================

/// Single row (id = 1, enforced by a CHECK). Was `settings` in community-store.json.
model SiteSettings {
  id                 Int      @id @default(1)
  siteName           String   @map("site_name") @db.VarChar(80)
  tagline            String   @db.VarChar(200)
  heroEyebrow        String   @map("hero_eyebrow") @db.VarChar(160)
  heroHeadline       String   @map("hero_headline") @db.VarChar(160)
  heroHeadlineAccent String   @map("hero_headline_accent") @db.VarChar(120)
  heroIntro          String   @map("hero_intro") @db.VarChar(600)
  heroImageUrl       String?  @map("hero_image_url") @db.VarChar(500)
  announcement       String?  @db.VarChar(300)
  feeCore            Decimal? @map("fee_core") @db.Decimal(10, 2)
  feeAssociate       Decimal? @map("fee_associate") @db.Decimal(10, 2)
  feeStudent         Decimal? @map("fee_student") @db.Decimal(10, 2)
  contactEmail       String?  @map("contact_email") @db.Citext
  contactPhone       String?  @map("contact_phone") @db.VarChar(40)
  contactAddress     String?  @map("contact_address") @db.VarChar(400)
  contactMapUrl      String?  @map("contact_map_url") @db.VarChar(2000)
  socialLinkedin     String?  @map("social_linkedin") @db.VarChar(500)
  socialInstagram    String?  @map("social_instagram") @db.VarChar(500)
  socialFacebook     String?  @map("social_facebook") @db.VarChar(500)
  socialYoutube      String?  @map("social_youtube") @db.VarChar(500)
  socialX            String?  @map("social_x") @db.VarChar(500)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedById        String?  @map("updated_by_id")

  @@map("site_settings")
}

/// Admin-managed category lists (Settings → Categories). Content keeps its category as text, so a
/// retired term stays on old items, exactly like the current app.
model TaxonomyTerm {
  id        String       @id @default(dbgenerated("gen_random_uuid()::text"))
  kind      TaxonomyKind
  value     String       @db.Citext
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([kind, value])
  @@index([kind, sortOrder])
  @@map("taxonomy_terms")
}

// ===========================================================================================
// Public content
// ===========================================================================================

model Wing {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  number      Int      @unique
  name        String   @unique @db.Citext
  slug        String   @unique @db.VarChar(120)
  color       String   @db.Char(7)
  /// Focus areas shown as one line ("Direct Tax · GST").
  tags        String   @default("") @db.VarChar(300)
  activities  String[] @default([])
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  events      Event[]
  resources   Resource[]
  team        TeamMember[]
  jobs        Job[]
  memberships MembershipInterest[]
  mentors     MentorWing[]
  requests    MentorshipRequestWing[]

  @@index([isPublished, number])
  @@map("wings")
}

model Event {
  id               String    @id @default(dbgenerated("gen_random_uuid()::text"))
  slug             String    @unique @db.VarChar(80)
  title            String    @db.VarChar(200)
  wingId           String    @map("wing_id")
  category         String    @db.Citext
  /// Calendar date in IST; times are free text as entered ("10:00 AM").
  date             DateTime  @db.Date
  time             String    @db.VarChar(40)
  endTime          String?   @map("end_time") @db.VarChar(40)
  mode             EventMode
  venue            String    @db.VarChar(200)
  city             String    @default("") @db.VarChar(120)
  mapUrl           String?   @map("map_url") @db.VarChar(2000)
  fee              Decimal   @default(0) @db.Decimal(10, 2)
  memberFee        Decimal   @default(0) @map("member_fee") @db.Decimal(10, 2)
  seatsTotal       Int       @map("seats_total")
  /// Confirmed seats; paid bookings add theirs when the payment succeeds.
  seatsTaken       Int       @default(0) @map("seats_taken")
  cpeHours         Decimal?  @map("cpe_hours") @db.Decimal(5, 2)
  description      String
  terms            String?
  imageUrl         String?   @map("image_url") @db.VarChar(500)
  registrationOpen Boolean   @default(true) @map("registration_open")
  featured         Boolean   @default(false)
  isPublished      Boolean   @default(false) @map("is_published")
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancellationNote String?   @map("cancellation_note") @db.VarChar(1000)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  wing          Wing                @relation(fields: [wingId], references: [id], onDelete: Restrict)
  speakers      EventSpeaker[]
  agenda        EventAgendaItem[]
  registrations EventRegistration[]

  // Public listings: published events by date; wing pages; category filter; homepage featured.
  @@index([isPublished, date])
  @@index([wingId, date])
  @@index([category])
  @@index([featured, date])
  @@map("events")
}

model EventAgendaItem {
  id       String  @id @default(dbgenerated("gen_random_uuid()::text"))
  eventId  String  @map("event_id")
  position Int
  time     String  @default("") @db.VarChar(40)
  title    String  @db.VarChar(200)
  speaker  String? @db.VarChar(120)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, position])
  @@map("event_agenda_items")
}

model Speaker {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  slug          String   @unique @db.VarChar(80)
  name          String   @db.VarChar(120)
  title         String   @db.VarChar(160)
  qualification String?  @db.VarChar(120)
  organisation  String?  @db.VarChar(160)
  headline      String?  @db.VarChar(140)
  bio           String   @db.VarChar(2000)
  expertise     String[] @default([])
  highlights    String[] @default([])
  talks         String[] @default([])
  /// [{ value, label }] — at most 4, validated by a CHECK.
  stats         Json     @default("[]")
  quote         String?  @db.VarChar(300)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  linkedinUrl   String?  @map("linkedin_url") @db.VarChar(500)
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  events EventSpeaker[]

  @@index([isPublished, name])
  @@map("speakers")
}

/// Replaces events.speakerSlugs: renaming a speaker's slug no longer needs relinking.
model EventSpeaker {
  eventId   String @map("event_id")
  speakerId String @map("speaker_id")
  position  Int    @default(0)

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker Speaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([eventId, speakerId])
  @@index([speakerId])
  @@map("event_speakers")
}

model NewsArticle {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  slug          String   @unique @db.VarChar(80)
  title         String   @db.VarChar(200)
  category      String   @db.Citext
  /// Display date as entered ("03 Nov 2026"); publishedOn is the sortable date.
  dateLabel     String   @map("date_label") @db.VarChar(40)
  publishedOn   DateTime @map("published_on") @db.Date
  author        String?  @db.VarChar(120)
  summary       String   @db.VarChar(600)
  content       String
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(500)
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isPublished, publishedOn(sort: Desc)])
  @@index([category])
  @@map("news_articles")
}

model Resource {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  title         String   @db.VarChar(200)
  category      String   @db.Citext
  format        String   @db.VarChar(80)
  wingId        String?  @map("wing_id")
  /// /resource-files/<name> (private storage) or an external https link.
  fileUrl       String?  @map("file_url") @db.VarChar(2000)
  isMembersOnly Boolean  @default(false) @map("is_members_only")
  downloads     Int      @default(0)
  isPublished   Boolean  @default(true) @map("is_published")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  wing Wing? @relation(fields: [wingId], references: [id], onDelete: Restrict)

  @@index([isPublished, category])
  @@index([wingId])
  @@map("resources")
}

model GalleryItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()::text"))
  title          String   @db.VarChar(200)
  category       String   @db.Citext
  dateLabel      String   @map("date_label") @db.VarChar(40)
  location       String   @db.VarChar(160)
  accentGradient String   @default("") @map("accent_gradient") @db.VarChar(200)
  imageUrl       String?  @map("image_url") @db.VarChar(500)
  videoUrl       String?  @map("video_url") @db.VarChar(2000)
  isPublished    Boolean  @default(true) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isPublished, category])
  @@map("gallery_items")
}

model TeamMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  name        String    @db.VarChar(120)
  designation String    @db.VarChar(160)
  group       TeamGroup @map("team_group")
  wingId      String?   @map("wing_id")
  background  String?   @db.VarChar(2000)
  photoUrl    String?   @map("photo_url") @db.VarChar(500)
  linkedinUrl String?   @map("linkedin_url") @db.VarChar(500)
  sortOrder   Int       @default(10) @map("sort_order")
  isPublished Boolean   @default(true) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  wing Wing? @relation(fields: [wingId], references: [id], onDelete: Restrict)

  @@index([isPublished, group, sortOrder])
  @@index([wingId])
  @@map("team_members")
}

model Testimonial {
  id          String   @id @default(dbgenerated("gen_random_uuid()::text"))
  name        String   @db.VarChar(120)
  designation String?  @db.VarChar(160)
  quote       String   @db.VarChar(1200)
  photoUrl    String?  @map("photo_url") @db.VarChar(500)
  isPublished Boolean  @default(true) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isPublished, createdAt])
  @@map("testimonials")
}

model Initiative {
  id          String    @id @default(dbgenerated("gen_random_uuid()::text"))
  title       String    @db.VarChar(160)
  description String    @db.VarChar(1200)
  tag         String?   @db.VarChar(60)
  date        DateTime? @db.Date
  ctaLabel    String?   @map("cta_label") @db.VarChar(60)
  ctaUrl      String?   @map("cta_url") @db.VarChar(2000)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  isPublished Boolean   @default(true) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isPublished, date])
  @@map("initiatives")
}

model Job {
  id            String    @id @default(dbgenerated("gen_random_uuid()::text"))
  slug          String    @unique @db.VarChar(80)
  title         String    @db.VarChar(160)
  organisation  String    @db.VarChar(160)
  type          String    @db.Citext
  location      String    @db.VarChar(120)
  workMode      WorkMode  @map("work_mode")
  experience    String?   @db.VarChar(120)
  compensation  String?   @db.VarChar(120)
  description   String
  requirements  String[]  @default([])
  applyUrl      String?   @map("apply_url") @db.VarChar(2000)
  applyEmail    String?   @map("apply_email") @db.Citext
  /// The post is hidden after this date.
  deadline      DateTime? @db.Date
  wingId        String?   @map("wing_id")
  logoUrl       String?   @map("logo_url") @db.VarChar(500)
  isMembersOnly Boolean   @default(false) @map("is_members_only")
  featured      Boolean   @default(false)
  isPublished   Boolean   @default(true) @map("is_published")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  wing Wing? @relation(fields: [wingId], references: [id], onDelete: Restrict)

  // Careers board: published and not past the deadline, featured first.
  @@index([isPublished, deadline])
  @@index([type])
  @@index([wingId])
  @@map("jobs")
}

// ===========================================================================================
// Accounts & sessions
// ===========================================================================================

model MemberAccount {
  id              String    @id @default(dbgenerated("gen_random_uuid()::text"))
  name            String    @db.VarChar(120)
  /// citext: unique regardless of letter case.
  email           String    @unique @db.Citext
  mobile          String?   @db.VarChar(20)
  /// scrypt$N$r$p$salt$hash — never a plaintext password.
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  /// Bumped on password change/reset: signs out every other session.
  sessionVersion  Int       @default(1) @map("session_version")
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  profile            MemberProfile?
  tokens             AuthToken[]
  registrations      EventRegistration[]
  membership         Membership?
  mentor             Mentor?
  mentorshipRequests MentorshipRequest[]

  @@map("member_accounts")
}

model MemberProfile {
  accountId         String   @id @map("account_id")
  city              String?  @db.VarChar(120)
  membershipNo      String?  @map("membership_no") @db.VarChar(40)
  qualificationYear String?  @map("qualification_year") @db.VarChar(10)
  areaOfPractice    String?  @map("area_of_practice") @db.VarChar(160)
  organisation      String?  @db.VarChar(160)
  designation       String?  @db.VarChar(160)
  linkedinUrl       String?  @map("linkedin_url") @db.VarChar(500)
  bio               String?  @db.VarChar(2000)
  photoUrl          String?  @map("photo_url") @db.VarChar(500)
  /// Listed in the members-only directory (off by default).
  directoryOptIn    Boolean  @default(false) @map("directory_opt_in")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([directoryOptIn, city])
  @@map("member_profiles")
}

/// Email-verification and password-reset tokens. Only the SHA-256 of the token is stored; a token
/// is single use (used_at) and short-lived (expires_at).
model AuthToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId String           @map("account_id")
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  account MemberAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

model AdminUser {
  id                String    @id @default(dbgenerated("gen_random_uuid()::text"))
  username          String    @unique @db.Citext
  name              String    @db.VarChar(120)
  role              AdminRole @default(ADMIN)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  active            Boolean   @default(true)
  /// Sessions issued before this are rejected.
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  /// TOTP secret, encrypted by the app (AES-256-GCM, key from env) — never stored in plaintext.
  totpSecretEnc     String?   @map("totp_secret_enc") @db.VarChar(255)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  auditLogs AuditLog[]

  @@map("admin_users")
}

/// Shared, durable brute-force counters (login, Basic auth, forms) so limits hold across restarts
/// and several app instances. Keys are "<scope>:<subject>", e.g. "admin-login:user:alice".
model RateLimitBucket {
  key         String   @id @db.VarChar(200)
  count       Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ===========================================================================================
// Bookings & payments
// ===========================================================================================

model EventRegistration {
  id               String             @id @default(dbgenerated("gen_random_uuid()::text"))
  /// Human booking reference shown on passes (ASC-…).
  bookingId        String             @unique @map("booking_id") @db.VarChar(40)
  /// SHA-256 of the access token in the booking link — the token itself is never stored.
  accessTokenHash  String             @unique @map("access_token_hash") @db.Char(64)
  /// SHA-256 of the QR check-in code.
  checkinCodeHash  String?            @unique @map("checkin_code_hash") @db.Char(64)
  /// The booking-link token and check-in code, encrypted by the website (AES-256-GCM, key in
  /// BOOKING_TOKEN_KEY — never in the database) so links and QR passes can be shown again.
  accessTokenEnc   String?            @map("access_token_enc") @db.VarChar(200)
  checkinCodeEnc   String?            @map("checkin_code_enc") @db.VarChar(200)
  eventId          String             @map("event_id")
  /// Set when the email belongs to a verified member account.
  accountId        String?            @map("account_id")
  /// Title at booking time, for receipts and certificates.
  eventTitle       String             @map("event_title") @db.VarChar(200)
  name             String             @db.VarChar(120)
  email            String             @db.Citext
  mobile           String             @db.VarChar(20)
  city             String             @db.VarChar(80)
  membershipNo     String?            @map("membership_no") @db.VarChar(40)
  organisation     String?            @db.VarChar(120)
  designation      String?            @db.VarChar(120)
  requirements     String?            @db.VarChar(1000)
  whatsappOptIn    Boolean            @default(false) @map("whatsapp_opt_in")
  fee              Decimal            @default(0) @db.Decimal(10, 2)
  status           RegistrationStatus
  paymentStatus    PaymentStatus      @map("payment_status")
  gatewayOrderId   String?            @unique @map("gateway_order_id") @db.VarChar(64)
  gatewayPaymentId String?            @unique @map("gateway_payment_id") @db.VarChar(64)
  paidAt           DateTime?          @map("paid_at") @db.Timestamptz(3)
  refundId         String?            @unique @map("refund_id") @db.VarChar(64)
  refundAmount     Decimal?           @map("refund_amount") @db.Decimal(10, 2)
  refundedAt       DateTime?          @map("refunded_at") @db.Timestamptz(3)
  attended         Boolean            @default(false)
  attendedAt       DateTime?          @map("attended_at") @db.Timestamptz(3)
  certificateId    String?            @unique @map("certificate_id") @db.VarChar(40)
  reminderSentAt   DateTime?          @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Also the seat-hold clock for unpaid bookings (30-minute hold).
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  account MemberAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Admin event dashboard + seat holds (event, status, hold clock).
  @@index([eventId, status, updatedAt])
  // Member dashboard ("my bookings") and duplicate checks.
  @@index([email])
  @@index([accountId])
  // Admin "pending payments" badge and payments list.
  @@index([paymentStatus, createdAt(sort: Desc)])
  // Registrations list, newest first.
  @@index([createdAt(sort: Desc)])
  @@map("event_registrations")
}

/// Membership application + current term (one per email; renewals add MembershipPayment rows).
model Membership {
  id                 String           @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId          String?          @unique @map("account_id")
  name               String           @db.VarChar(120)
  email              String           @unique @db.Citext
  mobile             String           @db.VarChar(20)
  city               String           @db.VarChar(120)
  plan               MembershipPlan
  membershipNo       String?          @map("membership_no") @db.VarChar(40)
  qualificationYear  String?          @map("qualification_year") @db.VarChar(10)
  areaOfPractice     String?          @map("area_of_practice") @db.VarChar(160)
  organisation       String?          @db.VarChar(160)
  linkedinUrl        String?          @map("linkedin_url") @db.VarChar(500)
  photoUrl           String?          @map("photo_url") @db.VarChar(500)
  status             MembershipStatus @default(PENDING)
  /// Fee fixed when the application is approved (admin only — the website role cannot change it).
  fee                Decimal?         @db.Decimal(10, 2)
  gatewayOrderId     String?          @unique @map("gateway_order_id") @db.VarChar(64)
  /// Amount of the open Razorpay order (first payment or renewal); the payment is checked against it.
  orderAmount        Decimal?         @map("order_amount") @db.Decimal(10, 2)
  validUntil         DateTime?        @map("valid_until") @db.Timestamptz(3)
  /// The validUntil a renewal reminder was sent for (one reminder per term).
  renewalReminderFor DateTime?        @map("renewal_reminder_for") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account   MemberAccount?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments  MembershipPayment[]
  interests MembershipInterest[]

  // Admin members list filters; renewal reminder scan (approved, expiring soon).
  @@index([status, createdAt(sort: Desc)])
  @@index([plan])
  @@index([city])
  @@index([status, validUntil])
  @@map("memberships")
}

model MembershipInterest {
  membershipId String @map("membership_id")
  wingId       String @map("wing_id")

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  wing       Wing       @relation(fields: [wingId], references: [id], onDelete: Cascade)

  @@id([membershipId, wingId])
  @@index([wingId])
  @@map("membership_interests")
}

model MembershipPayment {
  id               String        @id @default(dbgenerated("gen_random_uuid()::text"))
  /// Receipt number shown on the PDF.
  receiptId        String        @unique @map("receipt_id") @db.VarChar(40)
  membershipId     String        @map("membership_id")
  amount           Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  gatewayOrderId   String?       @map("gateway_order_id") @db.VarChar(64)
  gatewayPaymentId String?       @unique @map("gateway_payment_id") @db.VarChar(64)
  paidAt           DateTime      @map("paid_at") @db.Timestamptz(3)
  validFrom        DateTime      @map("valid_from") @db.Timestamptz(3)
  validUntil       DateTime      @map("valid_until") @db.Timestamptz(3)
  /// Admin who recorded an offline payment.
  recordedById     String?       @map("recorded_by_id")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Restrict)

  @@index([membershipId, paidAt(sort: Desc)])
  @@map("membership_payments")
}

// ===========================================================================================
// Mentorship
// ===========================================================================================

model Mentor {
  id          String       @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId   String       @unique @map("account_id")
  headline    String       @db.VarChar(160)
  expertise   String[]     @default([])
  modes       MentorMode[] @default([])
  city        String?      @db.VarChar(120)
  capacity    Int          @default(1)
  bio         String       @db.VarChar(1500)
  linkedinUrl String?      @map("linkedin_url") @db.VarChar(500)
  status      MentorStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account     MemberAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  wings       MentorWing[]
  mentees     MentorshipRequest[] @relation("MatchedMentor")
  preferredBy MentorshipRequest[] @relation("PreferredMentor")

  @@index([status])
  @@map("mentors")
}

model MentorWing {
  mentorId String @map("mentor_id")
  wingId   String @map("wing_id")

  mentor Mentor @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  wing   Wing   @relation(fields: [wingId], references: [id], onDelete: Cascade)

  @@id([mentorId, wingId])
  @@index([wingId])
  @@map("mentor_wings")
}

model MentorshipRequest {
  id                String                  @id @default(dbgenerated("gen_random_uuid()::text"))
  accountId         String                  @map("account_id")
  stage             MentorshipStage
  goals             String                  @db.VarChar(1500)
  preferredMentorId String?                 @map("preferred_mentor_id")
  mentorId          String?                 @map("mentor_id")
  status            MentorshipRequestStatus @default(OPEN)
  matchedAt         DateTime?               @map("matched_at") @db.Timestamptz(3)
  adminNote         String?                 @map("admin_note") @db.VarChar(500)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  account         MemberAccount           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mentor          Mentor?                 @relation("MatchedMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  preferredMentor Mentor?                 @relation("PreferredMentor", fields: [preferredMentorId], references: [id], onDelete: SetNull)
  wings           MentorshipRequestWing[]

  // Admin queue (open first, newest); capacity count (mentor, status = matched); member view.
  @@index([status, createdAt(sort: Desc)])
  @@index([mentorId, status])
  @@index([accountId, status])
  @@index([preferredMentorId])
  @@map("mentorship_requests")
}

model MentorshipRequestWing {
  requestId String @map("request_id")
  wingId    String @map("wing_id")

  request MentorshipRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  wing    Wing              @relation(fields: [wingId], references: [id], onDelete: Cascade)

  @@id([requestId, wingId])
  @@index([wingId])
  @@map("mentorship_request_wings")
}

// ===========================================================================================
// Inbox, notifications, audit
// ===========================================================================================

model ContactMessage {
  id        String        @id @default(dbgenerated("gen_random_uuid()::text"))
  name      String        @db.VarChar(120)
  email     String        @db.Citext
  phone     String?       @db.VarChar(20)
  subject   String        @db.VarChar(160)
  message   String        @db.VarChar(5000)
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt(sort: Desc)])
  @@map("contact_messages")
}

/// Durable email / WhatsApp queue (replaces data/outbox). A worker sends QUEUED rows and retries
/// FAILED ones with backoff; rows are purged after the retention period.
model NotificationOutbox {
  id            String        @id @default(dbgenerated("gen_random_uuid()::text"))
  channel       OutboxChannel
  recipient     String        @db.VarChar(320)
  template      String        @db.VarChar(80)
  subject       String?       @db.VarChar(300)
  /// Rendered message or template parameters.
  payload       Json
  status        OutboxStatus  @default(QUEUED)
  attempts      Int           @default(0)
  lastError     String?       @map("last_error") @db.VarChar(1000)
  nextAttemptAt DateTime      @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime?     @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  // Worker: oldest due QUEUED/FAILED rows first. Retention: delete by created_at.
  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("notification_outbox")
}

/// Append-only record of every admin write (who, what, when, from where). The app role may only
/// INSERT and SELECT; a trigger blocks UPDATE and DELETE (see sql/20-security.sql).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  adminId   String?  @map("admin_id")
  /// e.g. "event.update", "registration.refund", "member.approve", "settings.update"
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.VarChar(80)
  /// Changed fields only, with secrets removed by the app.
  changes   Json?
  ip        String?  @db.Inet
  userAgent String?  @map("user_agent") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
